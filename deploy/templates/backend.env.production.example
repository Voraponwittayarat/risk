# Copy this file to backend/.env on the server, then replace every CHANGE_ME value.
# Never commit backend/.env.

NODE_ENV="production"
HOST="0.0.0.0"
PORT="3000"
DATABASE_URL="mysql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@127.0.0.1:3306/riskhospital"
JWT_SECRET="CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS"

# Keep runtime uploads outside the Git repository.
UPLOAD_DIR="D:/RiskHRMS-data/uploads"

# The frontend is served by the backend in production. Add public HTTPS origins
# only when a separate reverse proxy or hostname is used.
CORS_ORIGINS=""
SWAGGER_ENABLED="false"

# External AI processing must remain off until hospital privacy policy approves it.
AI_ASSISTANT_ENABLED="false"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_API_KEY=""

LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
SMTP_USER=""
SMTP_PASS=""
TELEGRAM_CHAT_ID=""
TELEGRAM_BOT_TOKEN=""

# RCA appointments use the same hospital Telegram bot/chat as E/3 alerts
RCA_TELEGRAM_APPOINTMENTS_ENABLED=true
