# Copy to /opt/riskhrms/backend/.env and replace every CHANGE_ME value.
# Keep mode 600, owner riskhrms:riskhrms, and never commit this file.

NODE_ENV="production"
HOST="127.0.0.1"
PORT="3000"
DATABASE_URL="mysql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@127.0.0.1:3306/riskhospital"
# Optional dedicated read/backup account. Leave empty to use DATABASE_URL.
BACKUP_DATABASE_URL=""
JWT_SECRET="CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS"
UPLOAD_DIR="/var/lib/riskhrms/uploads"

# Nginx serves the public HTTPS origin and proxies to 127.0.0.1:3000.
CORS_ORIGINS=""
SWAGGER_ENABLED="false"

# Keep external AI off until hospital privacy policy explicitly approves it.
AI_ASSISTANT_ENABLED="false"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_API_KEY=""

LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
SMTP_USER=""
SMTP_PASS=""
TELEGRAM_CHAT_ID=""
TELEGRAM_BOT_TOKEN=""
