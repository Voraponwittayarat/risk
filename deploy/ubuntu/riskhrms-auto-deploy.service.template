[Unit]
Description=RiskHRMS guarded automatic deployment
Documentation=file://@@PROJECT_ROOT@@/deploy/README-UBUNTU-TH.md
Wants=network-online.target
After=network-online.target mariadb.service
ConditionPathExists=@@PROJECT_ROOT@@/deploy/ubuntu/auto-deploy-hrms.sh

[Service]
Type=oneshot
User=root
Group=root
Environment=PATH=@@NODE_BIN_DIR@@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/bash @@PROJECT_ROOT@@/deploy/ubuntu/auto-deploy-hrms.sh
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
