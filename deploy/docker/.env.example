# RiskHRMS Docker deployment environment.
# Copy to deploy/docker/.env, then replace every CHANGE_ME value.
# This file is read by docker compose and is never committed (*.env is ignored).
# Keep MARIADB_* values in sync with DATABASE_URL (user, password, database).

# --- Compose / ports ---------------------------------------------------
# Host interface the app port binds to. Keep 127.0.0.1 so the host Nginx
# terminates TLS exactly as in the systemd deployment.
APP_BIND="127.0.0.1"
APP_PORT="3000"
APP_IMAGE_TAG="local"
TZ="Asia/Bangkok"

# --- MariaDB container ---------------------------------------------------
MARIADB_ROOT_PASSWORD="CHANGE_ME_USE_A_LONG_RANDOM_VALUE"
MARIADB_DATABASE="riskhospital"
MARIADB_USER="riskhrms"
MARIADB_PASSWORD="CHANGE_ME_USE_A_LONG_RANDOM_VALUE"

# --- Application (backend) ----------------------------------------------
NODE_ENV="production"
HOST="0.0.0.0"
PORT="3000"
# "db" is the MariaDB service inside the compose network. To use an existing
# MariaDB outside Docker instead, point this at that server and disable the
# db service in docker-compose.yml (see README-DOCKER-TH.md).
DATABASE_URL="mysql://riskhrms:CHANGE_ME@db:3306/riskhospital"
# Optional dedicated read/backup account. Leave empty to use DATABASE_URL.
BACKUP_DATABASE_URL=""
JWT_SECRET="CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS"
UPLOAD_DIR="/app/uploads"

# Nginx serves the public HTTPS origin and proxies to 127.0.0.1:3000.
CORS_ORIGINS=""
SWAGGER_ENABLED="false"

# Keep external AI off until hospital privacy policy explicitly approves it.
AI_ASSISTANT_ENABLED="false"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_API_KEY=""

LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
SMTP_USER=""
SMTP_PASS=""
TELEGRAM_CHAT_ID=""
TELEGRAM_BOT_TOKEN=""

# Set to "1" only when a DBA applies migrations manually; the container
# otherwise runs `prisma migrate deploy` on every start.
SKIP_MIGRATIONS=""
