                    FROM user u 
                    INNER JOIN user_role r ON r.role_id=u.role
                    INNER JOIN member m ON m.cid collate utf8_general_ci=u.cid collate utf8_general_ci 
                    LEFT JOIN team t ON t.id=m.team_id
