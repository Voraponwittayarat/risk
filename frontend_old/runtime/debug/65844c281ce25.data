    `kcu`.`CONSTRAINT_NAME` AS `name`,
    `kcu`.`COLUMN_NAME` AS `column_name`,
    `tc`.`CONSTRAINT_TYPE` AS `type`,
    CASE
        WHEN NULL IS NULL AND `kcu`.`REFERENCED_TABLE_SCHEMA` = DATABASE() THEN NULL
        ELSE `kcu`.`REFERENCED_TABLE_SCHEMA`
    END AS `foreign_table_schema`,
    `kcu`.`REFERENCED_TABLE_NAME` AS `foreign_table_name`,
    `kcu`.`REFERENCED_COLUMN_NAME` AS `foreign_column_name`,
    `rc`.`UPDATE_RULE` AS `on_update`,
    `rc`.`DELETE_RULE` AS `on_delete`,
    `kcu`.`ORDINAL_POSITION` AS `position`
FROM
    `information_schema`.`KEY_COLUMN_USAGE` AS `kcu`,
    `information_schema`.`REFERENTIAL_CONSTRAINTS` AS `rc`,
    `information_schema`.`TABLE_CONSTRAINTS` AS `tc`
WHERE
    `kcu`.`TABLE_SCHEMA` = COALESCE(NULL, DATABASE()) AND `kcu`.`CONSTRAINT_SCHEMA` = `kcu`.`TABLE_SCHEMA` AND `kcu`.`TABLE_NAME` = 'session_frontend_user'
    AND `rc`.`CONSTRAINT_SCHEMA` = `kcu`.`TABLE_SCHEMA` AND `rc`.`TABLE_NAME` = 'session_frontend_user' AND `rc`.`CONSTRAINT_NAME` = `kcu`.`CONSTRAINT_NAME`
    AND `tc`.`TABLE_SCHEMA` = `kcu`.`TABLE_SCHEMA` AND `tc`.`TABLE_NAME` = 'session_frontend_user' AND `tc`.`CONSTRAINT_NAME` = `kcu`.`CONSTRAINT_NAME` AND `tc`.`CONSTRAINT_TYPE` = 'FOREIGN KEY'
UNION
SELECT
    `kcu`.`CONSTRAINT_NAME` AS `name`,
    `kcu`.`COLUMN_NAME` AS `column_name`,
    `tc`.`CONSTRAINT_TYPE` AS `type`,
    NULL AS `foreign_table_schema`,
    NULL AS `foreign_table_name`,
    NULL AS `foreign_column_name`,
    NULL AS `on_update`,
    NULL AS `on_delete`,
    `kcu`.`ORDINAL_POSITION` AS `position`
FROM
    `information_schema`.`KEY_COLUMN_USAGE` AS `kcu`,
    `information_schema`.`TABLE_CONSTRAINTS` AS `tc`
WHERE
    `kcu`.`TABLE_SCHEMA` = COALESCE(NULL, DATABASE()) AND `kcu`.`TABLE_NAME` = 'session_frontend_user'
    AND `tc`.`TABLE_SCHEMA` = `kcu`.`TABLE_SCHEMA` AND `tc`.`TABLE_NAME` = 'session_frontend_user' AND `tc`.`CONSTRAINT_NAME` = `kcu`.`CONSTRAINT_NAME` AND `tc`.`CONSTRAINT_TYPE` IN ('PRIMARY KEY', 'UNIQUE')
ORDER BY `position` ASC";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1703169064.152926;i:4;a:0:{}i:5;i:2761440;}i:84;a:6:{i:0;s:403:"SELECT
    `s`.`INDEX_NAME` AS `name`,
    `s`.`COLUMN_NAME` AS `column_name`,
    `s`.`NON_UNIQUE` ^ 1 AS `index_is_unique`,
    `s`.`INDEX_NAME` = 'PRIMARY' AS `index_is_primary`
FROM `information_schema`.`STATISTICS` AS `s`
WHERE `s`.`TABLE_SCHEMA` = COALESCE(NULL, DATABASE()) AND `s`.`INDEX_SCHEMA` = `s`.`TABLE_SCHEMA` AND `s`.`TABLE_NAME` = 'session_frontend_user'
ORDER BY `s`.`SEQ_IN_INDEX` ASC";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1703169064.1542971;i:4;a:0:{}i:5;i:2768688;}i:87;a:6:{i:0;s:296:"INSERT INTO `session_frontend_user` (`data`, `user_id`, `ip`, `id`, `expire`) VALUES ('__flash|a:0:{}__id|i:253;', 253, '10.0.0.201', 'sq5e5jum69dmd1f78g8hncd4j7', 1703170504) ON DUPLICATE KEY UPDATE `data`=VALUES(`data`), `user_id`=VALUES(`user_id`), `ip`=VALUES(`ip`), `expire`=VALUES(`expire`)";i:1;i:4;i:2;s:23:"yii\db\Command::execute";i:3;d:1703169064.1548941;i:4;a:0:{}i:5;i:2771344;}}}";s:9:"profiling";s:36287:"a:3:{s:6:"memory";i:3068320;s:4:"time";d:0.055052995681762695;s:8:"messages";a:48:{i:5;a:6:{i:0;s:73:"Opening DB connection: mysql:host=127.0.0.1;port=3306;dbname=riskhospital";i:1;i:80;i:2;s:23:"yii\db\Connection::open";i:3;d:1703169064.1138401;i:4;a:0:{}i:5;i:1665152;}i:6;a:6:{i:0;s:73:"Opening DB connection: mysql:host=127.0.0.1;port=3306;dbname=riskhospital";i:1;i:96;i:2;s:23:"yii\db\Connection::open";i:3;d:1703169064.1143799;i:4;a:0:{}i:5;i:1676720;}i:8;a:6:{i:0;s:106:"SELECT `data` FROM `session_frontend_user` WHERE `expire`>1703169064 AND `id`='sq5e5jum69dmd1f78g8hncd4j7'";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1703169064.114502;i:4;a:0:{}i:5;i:1674016;}i:9;a:6:{i:0;s:106:"SELECT `data` FROM `session_frontend_user` WHERE `expire`>1703169064 AND `id`='sq5e5jum69dmd1f78g8hncd4j7'";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1703169064.114826;i:4;a:0:{}i:5;i:1674840;}i:12;a:6:{i:0;s:29:"SHOW FULL COLUMNS FROM `user`";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1703169064.1151271;i:4;a:1:{i:0;a:5:{s:4:"file";s:60:"/var/www/html/risk/vendor/dektrium/yii2-user/models/User.php";s:4:"line";i:582;s:8:"function";s:7:"findOne";s:5:"class";s:23:"yii\db\BaseActiveRecord";s:4:"type";s:2:"::";}}i:5;i:1680320;}i:13;a:6:{i:0;s:29:"SHOW FULL COLUMNS FROM `user`";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1703169064.1157899;i:4;a:1:{i:0;a:5:{s:4:"file";s:60:"/var/www/html/risk/vendor/dektrium/yii2-user