    kcu.constraint_name,
    kcu.column_name,
    kcu.referenced_table_name,
    kcu.referenced_column_name
FROM information_schema.referential_constraints AS rc
JOIN information_schema.key_column_usage AS kcu ON
    (
        kcu.constraint_catalog = rc.constraint_catalog OR
        (kcu.constraint_catalog IS NULL AND rc.constraint_catalog IS NULL)
    ) AND
    kcu.constraint_schema = rc.constraint_schema AND
    kcu.constraint_name = rc.constraint_name
WHERE rc.constraint_schema = database() AND kcu.table_schema = database()
AND rc.table_name = 'session_frontend_user' AND kcu.table_name = 'session_frontend_user'";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1703148577.7899759;i:4;a:0:{}i:5;i:2084896;}i:88;a:6:{i:0;s:2009:"SELECT
    `kcu`.`CONSTRAINT_NAME` AS `name`,
    `kcu`.`COLUMN_NAME` AS `column_name`,
    `tc`.`CONSTRAINT_TYPE` AS `type`,
    CASE
        WHEN NULL IS NULL AND `kcu`.`REFERENCED_TABLE_SCHEMA` = DATABASE() THEN NULL
        ELSE `kcu`.`REFERENCED_TABLE_SCHEMA`
    END AS `foreign_table_schema`,
    `kcu`.`REFERENCED_TABLE_NAME` AS `foreign_table_name`,
    `kcu`.`REFERENCED_COLUMN_NAME` AS `foreign_column_name`,
    `rc`.`UPDATE_RULE` AS `on_update`,
    `rc`.`DELETE_RULE` AS `on_delete`,
    `kcu`.`ORDINAL_POSITION` AS `position`
FROM
    `information_schema`.`KEY_COLUMN_USAGE` AS `kcu`,
    `information_schema`.`REFERENTIAL_CONSTRAINTS` AS `rc`,
    `information_schema`.`TABLE_CONSTRAINTS` AS `tc`
WHERE
    `kcu`.`TABLE_SCHEMA` = COALESCE(NULL, DATABASE()) AND `kcu`.`CONSTRAINT_SCHEMA` = `kcu`.`TABLE_SCHEMA` AND `kcu`.`TABLE_NAME` = 'session_frontend_user'
    AND `rc`.`CONSTRAINT_SCHEMA` = `kcu`.`TABLE_SCHEMA` AND `rc`.`TABLE_NAME` = 'session_frontend_user' AND `rc`.`CONSTRAINT_NAME` = `kcu`.`CONSTRAINT_NAME`
    AND `tc`.`TABLE_SCHEMA` = `kcu`.`TABLE_SCHEMA` AND `tc`.`TABLE_NAME` = 'session_frontend_user' AND `tc`.`CONSTRAINT_NAME` = `kcu`.`CONSTRAINT_NAME` AND `tc`.`CONSTRAINT_TYPE` = 'FOREIGN KEY'
UNION
SELECT
    `kcu`.`CONSTRAINT_NAME` AS `name`,
    `kcu`.`COLUMN_NAME` AS `column_name`,
    `tc`.`CONSTRAINT_TYPE` AS `type`,
    NULL AS `foreign_table_schema`,
    NULL AS `foreign_table_name`,
    NULL AS `foreign_column_name`,
    NULL AS `on_update`,
    NULL AS `on_delete`,
    `kcu`.`ORDINAL_POSITION` AS `position`
FROM
    `information_schema`.`KEY_COLUMN_USAGE` AS `kcu`,
    `information_schema`.`TABLE_CONSTRAINTS` AS `tc`
WHERE
    `kcu`.`TABLE_SCHEMA` = COALESCE(NULL, DATABASE()) AND `kcu`.`TABLE_NAME` = 'session_frontend_user'
    AND `tc`.`TABLE_SCHEMA` = `kcu`.`TABLE_SCHEMA` AND `tc`.`TABLE_NAME` = 'session_frontend_user' AND `tc`.`CONSTRAINT_NAME` = `kcu`.`CONSTRAINT_NAME` AND `tc`.`CONSTRAINT_TYPE` IN ('PRIMARY KEY', 'UNIQUE')
ORDER BY `position` ASC";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1703148577.7905469;i:4;a:0:{}i:5;i:2091144;}i:91;a:6:{i:0;s:403:"SELECT
    `s`.`INDEX_NAME` AS `name`,
    `s`.`COLUMN_NAME` AS `column_name`,
    `s`.`NON_UNIQUE` ^ 1 AS `index_is_unique`,
    `s`.`INDEX_NAME` = 'PRIMARY' AS `index_is_primary`
FROM `information_schema`.`STATISTICS` AS `s`
WHERE `s`.`TABLE_SCHEMA` = COALESCE(NULL, DATABASE()) AND `s`.`INDEX_SCHEMA` = `s`.`TABLE_SCHEMA` AND `s`.`TABLE_NAME` = 'session_frontend_user'
ORDER BY `s`.`SEQ_IN_INDEX` ASC";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1703148577.791909;i:4;a:0:{}i:5;i:2098392;}i:94;a:6:{i:0;s:297:"INSERT INTO `session_frontend_user` (`data`, `user_id`, `ip`, `id`, `expire`) VALUES ('__flash|a:0:{}__id|i:416;', 416, '172.0.0.125', '9n0i18m3a7vqtnec59387fe8m7', 1703150017) ON DUPLICATE KEY UPDATE `data`=VALUES(`data`), `user_id`=VALUES(`user_id`), `ip`=VALUES(`ip`), `expire`=VALUES(`expire`)";i:1;i:4;i:2;s:23:"yii\db\Command::execute";i:3;d:1703148577.792516;i:4;a:0:{}i:5;i:2102056;}}}";s:9:"profiling";s:36539:"a:3:{s:6:"memory";i:2417576;s:4:"time";d:0.050717830657958984;s:8:"messages";a:54:{i:5;a:6:{i:0;s:73:"Opening DB connection: mysql:host=127.0.0.1;port=3306;dbname=riskhospital";i:1;i:80;i:2;s:23:"yii\db\Connection::open";i:3;d:1703148577.746943;i:4;a:0:{}i:5;i:1664920;}i:6;a:6:{i:0;s:73:"Opening DB connection: mysql:host=127.0.0.1;port=3306;dbname=riskhospital";i:1;i:96;i:2;s:23:"yii\db\Connection::open";i:3;d:1703148577.7473869;i:4;a:0:{}i:5;i:1676488;}i:8;a:6:{i:0;s:106:"SELECT `data` FROM `session_frontend_user` WHERE `expire`>1703148577 AND `id`='9n0i18m3a7vqtnec59387fe8m7'";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1703148577.747509;i:4;a:0:{}i:5;i:1673784;}i:9;a:6:{i:0;s:106:"SELECT `data` FROM `session_frontend_user` WHERE `expire`>1703148577 AND `id`='9n0i18m3a7vqtnec59387fe8m7'";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1703148577.7477729;i:4;a:0:{}i:5;i:1674608;}i:12;a:6:{i:0;s:29:"SHOW FULL COLUMNS FROM `user`";i:1;i:80;i:2;s:21:"yii\db\Command::query";i:3;d:1703148577.7480741;i:4;a:1:{i:0;a:5:{s:4:"file";s:60:"/var/www/html/risk/vendor/dektrium/yii2-user/models/User.php";s:4:"line";i:582;s:8:"function";s:7:"findOne";s:5:"class";s:23:"yii\db\BaseActiveRecord";s:4:"type";s:2:"::";}}i:5;i:1680088;}i:13;a:6:{i:0;s:29:"SHOW FULL COLUMNS FROM `user`";i:1;i:96;i:2;s:21:"yii\db\Command::query";i:3;d:1703148577.748673;i:4;a:1:{i:0;a:5:{s:4:"file";s:60:"/var/www/html/risk/vendor/dektrium/yii2-user/m