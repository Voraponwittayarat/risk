    kcu.constraint_name,
    kcu.column_name,
    kcu.referenced_table_name,
    kcu.referenced_column_name
FROM information_schema.referential_constraints AS rc
JOIN information_schema.key_column_usage AS kcu ON
    (
        kcu.constraint_catalog = rc.constraint_catalog OR
        (kcu.constraint_catalog IS NULL AND rc.constraint_catalog IS NULL)
    ) AND
    kcu.constraint_schema = rc.constraint_schema AND
    kcu.constraint_name = rc.constraint_name
WHERE rc.constraint_schema = database() AND kcu.table_schema = database()
AND rc.table_name = 'user' AND kcu.table_name = 'user'";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1703148577.170269;i:4;a:3:{i:0;a:5:{s:4:"file";s:55:"/var/www/html/risk/vendor/dektrium/yii2-user/Finder.php";s:4:"line";i:116;s:8:"function";s:3:"one";s:5:"class";s:18:"yii\db\ActiveQuery";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:55:"/var/www/html/risk/vendor/dektrium/yii2-user/Finder.php";s:4:"line";i:144;s:8:"function";s:18:"findUserByUsername";s:5:"class";s:20:"dektrium\user\Finder";s:4:"type";s:2:"->";}i:2;a:5:{s:4:"file";s:65:"/var/www/html/risk/vendor/dektrium/yii2-user/models/LoginForm.php";s:4:"line";i:168;s:8:"function";s:25:"findUserByUsernameOrEmail";s:5:"class";s:20:"dektrium\user\Finder";s:4:"type";s:2:"->";}}i:5;i:2007000;}i:27;a:6:{i:0;s:100:"Access to debugger is denied due to IP address restriction. The requesting IP address is 172.0.0.125";i:1;i:2;i:2;s:29:"yii\debug\Module::checkAccess";i:3;d:1703148577.4079471;i:4;a:2:{i:0;a:5:{s:4:"file";s:75:"/var/www/html/risk/vendor/dektrium/yii2-user/traits/AjaxValidationTrait.php";s:4:"line";i:35;s:8:"function";s:4:"send";s:5:"class";s:16:"yii\web\Response";s:4:"type";s:2:"->";}i:1;a:5:{s:4:"file";s:79:"/var/www/html/risk/vendor/dektrium/yii2-user/controllers/SecurityController.php";s:4:"line";i:158;s:8:"function";s:21:"performAjaxValidation";s:5:"class";s:44:"dektrium\user\controllers\SecurityController";s:4:"type";s:2:"->";}}i:5;i:2010760;}i:28;a:6:{i:0;s:46:"SHOW FULL COLUMNS FROM `session_frontend_user`";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1703148577.408247;i:4;a:0:{}i:5;i:1751856;}i:31;a:6:{i:0;s:629:"SELECT
    kcu.constraint_name,
    kcu.column_name,
    kcu.referenced_table_name,
    kcu.referenced_column_name
FROM information_schema.referential_constraints AS rc
JOIN information_schema.key_column_usage AS kcu ON
    (
        kcu.constraint_catalog = rc.constraint_catalog OR
        (kcu.constraint_catalog IS NULL AND rc.constraint_catalog IS NULL)
    ) AND
    kcu.constraint_schema = rc.constraint_schema AND
    kcu.constraint_name = rc.constraint_name
WHERE rc.constraint_schema = database() AND kcu.table_schema = database()
AND rc.table_name = 'session_frontend_user' AND kcu.table_name = 'session_frontend_user'";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1703148577.408958;i:4;a:0:{}i:5;i:1761816;}i:34;a:6:{i:0;s:2009:"SELECT
    `kcu`.`CONSTRAINT_NAME` AS `name`,
    `kcu`.`COLUMN_NAME` AS `column_name`,
    `tc`.`CONSTRAINT_TYPE` AS `type`,
    CASE
        WHEN NULL IS NULL AND `kcu`.`REFERENCED_TABLE_SCHEMA` = DATABASE() THEN NULL
        ELSE `kcu`.`REFERENCED_TABLE_SCHEMA`
    END AS `foreign_table_schema`,
    `kcu`.`REFERENCED_TABLE_NAME` AS `foreign_table_name`,
    `kcu`.`REFERENCED_COLUMN_NAME` AS `foreign_column_name`,
    `rc`.`UPDATE_RULE` AS `on_update`,
    `rc`.`DELETE_RULE` AS `on_delete`,
    `kcu`.`ORDINAL_POSITION` AS `position`
FROM
    `information_schema`.`KEY_COLUMN_USAGE` AS `kcu`,
    `information_schema`.`REFERENTIAL_CONSTRAINTS` AS `rc`,
    `information_schema`.`TABLE_CONSTRAINTS` AS `tc`
WHERE
    `kcu`.`TABLE_SCHEMA` = COALESCE(NULL, DATABASE()) AND `kcu`.`CONSTRAINT_SCHEMA` = `kcu`.`TABLE_SCHEMA` AND `kcu`.`TABLE_NAME` = 'session_frontend_user'
    AND `rc`.`CONSTRAINT_SCHEMA` = `kcu`.`TABLE_SCHEMA` AND `rc`.`TABLE_NAME` = 'session_frontend_user' AND `rc`.`CONSTRAINT_NAME` = `kcu`.`CONSTRAINT_NAME`
    AND `tc`.`TABLE_SCHEMA` = `kcu`.`TABLE_SCHEMA` AND `tc`.`TABLE_NAME` = 'session_frontend_user' AND `tc`.`CONSTRAINT_NAME` = `kcu`.`CONSTRAINT_NAME` AND `tc`.`CONSTRAINT_TYPE` = 'FOREIGN KEY'
UNION
SELECT
    `kcu`.`CONSTRAINT_NAME` AS `name`,
    `kcu`.`COLUMN_NAME` AS `column_name`,
    `tc`.`CONSTRAINT_TYPE` AS `type`,
    NULL AS `foreign_table_schema`,
    NULL AS `foreign_table_name`,
    NULL AS `foreign_column_name`,
    NULL AS `on_update`,
    NULL AS `on_delete`,
    `kcu`.`ORDINAL_POSITION` AS `position`
FROM
    `information_schema`.`KEY_COLUMN_USAGE` AS `kcu`,
    `information_schema`.`TABLE_CONSTRAINTS` AS `tc`
WHERE
    `kcu`.`TABLE_SCHEMA` = COALESCE(NULL, DATABASE()) AND `kcu`.`TABLE_NAME` = 'session_frontend_user'
    AND `tc`.`TABLE_SCHEMA` = `kcu`.`TABLE_SCHEMA` AND `tc`.`TABLE_NAME` = 'session_frontend_user' AND `tc`.`CONSTRAINT_NAME` = `kcu`.`CONSTRAINT_NAME` AND `tc`.`CONSTRAINT_TYPE` IN ('PRIMARY KEY', 'UNIQUE')
ORDER BY `position` ASC";i:1;i:4;i:2;s:21:"yii\db\Command::query";i:3;d:1703148577.4095509;i:4;a:0:{}i:5;i:1768064;}i:37;a:6:{i:0;s:403:"SELECT
    `s`.`INDEX_NAME` AS `name`,
    `s`.`COLUMN_NAME` AS `column_name`,
    `s`.`NON_UNIQUE` ^ 1 AS `index_is_unique`,
    `s`.`INDEX_NAME` = 'PRIMARY' AS `index_is_primary`
