  notified_at       DateTime @default(now()) @db.DateTime(0)
  recipient_scope   String?  @db.VarChar(100)

  @@index([entity_type, notification_type, notified_at], map: "idx_notification_entity_type")
}

model standard_rca_review_session {
  id                   Int               @id @default(autoincrement())
  standard_rca_case_id String            @db.VarChar(50)
  reviewers            String?           @db.Text
  review_date_time     DateTime?         @db.DateTime(0)
  notes                String?           @db.Text
  sort_order           Int?              @default(0)
  created_at           DateTime          @default(now()) @db.Timestamp(0)
  standard_rca_case    standard_rca_case @relation(fields: [standard_rca_case_id], references: [id], onDelete: Cascade)

  @@index([standard_rca_case_id], map: "idx_std_session_case_id")
}

model NRLS_riskstore {
  nrls_code     String         @id @db.VarChar(50)
  name          String         @db.Text
  group         String?        @db.VarChar(100)
  category      String?        @db.VarChar(200)
  type          String?        @db.VarChar(200)
  sub_type      String?        @db.VarChar(200)
  definition    String?        @db.Text
  remark        String?        @db.Text
  program_id    Int?
  program       program?       @relation(fields: [program_id], references: [program_id])
  local_risks   riskstore[]
  riskregisters riskregister[]

  @@map("nrls_riskstore")
}
