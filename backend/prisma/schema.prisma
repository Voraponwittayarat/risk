  has_trigger       Boolean?  @default(false)
  has_adverse_event Boolean?  @default(false)
  has_error         Boolean?  @default(false)
  severity_level    String?   @db.VarChar(10)
  preventability    String?   @db.VarChar(50)
  ae_description    String?   @db.Text
  standard_rca_id   String?   @db.VarChar(50)
  created_at        DateTime  @default(now()) @db.Timestamp(0)
  updated_at        DateTime  @default(now()) @db.Timestamp(0)
  findings          trigger_finding[]
}

model trigger_finding {
  id           Int      @id @default(autoincrement())
  review_id    Int
  trigger_id   Int
  trigger_name String   @db.VarChar(255)
  detail       String?  @db.Text
  created_at   DateTime @default(now()) @db.Timestamp(0)
  review       medical_record_review @relation(fields: [review_id], references: [id], onDelete: Cascade)

  @@index([review_id], map: "idx_review_id")
}

model rca_case {
  id              String    @id @db.VarChar(50)
  topic           String    @db.VarChar(255)
  rca_type        String?   @default("mini") @db.VarChar(20)
  review_date     DateTime  @db.DateTime(0)
  incident_date   DateTime? @db.DateTime(0)
  incident_detail String?   @db.Text
  created_by      Int?
  created_at      DateTime  @default(now()) @db.Timestamp(0)
  updated_at      DateTime  @default(now()) @db.Timestamp(0)
  incidents       rca_incident_item[]
  swiss_cheeses   rca_swiss_cheese[]
  cmps            rca_cmp[]
  reviewers       rca_reviewer[]
}

model rca_incident_item {
  id               Int       @id @default(autoincrement())
  rca_case_id      String    @db.VarChar(50)
  incident_id      Int
  incident_id_risk Int       @default(0)
  risk_name        String?   @db.VarChar(255)
  report_date      DateTime? @db.Date
  severity_level   String?   @db.VarChar(10)
  department_id    String?   @db.VarChar(10)
  detail           String?   @db.Text
  sort_order       Int?      @default(0)
  created_at       DateTime  @default(now()) @db.Timestamp(0)
  rca_case         rca_case  @relation(fields: [rca_case_id], references: [id], onDelete: Cascade)

  @@index([rca_case_id], map: "idx_rca_case_id")
  @@index([incident_id], map: "idx_incident_id")
}

model rca_swiss_cheese {
  id          Int      @id @default(autoincrement())
  rca_case_id String   @db.VarChar(50)
  layer       String   @db.VarChar(50)
  hole        String   @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(0)
  rca_case    rca_case @relation(fields: [rca_case_id], references: [id], onDelete: Cascade)

  @@index([rca_case_id], map: "idx_swiss_rca_case_id")
}

model rca_cmp {
  id                Int       @id @default(autoincrement())
  rca_case_id       String    @db.VarChar(50)
  process           String?   @db.VarChar(100)
  cmp_problem       String    @db.Text
  corrective_action String    @db.Text
  responsible_unit  String?   @db.VarChar(100)
  status            String?   @default("pending") @db.VarChar(50)
  due_date          DateTime? @db.Date
  sort_order        Int?      @default(0)
  created_at        DateTime  @default(now()) @db.Timestamp(0)
  rca_case          rca_case  @relation(fields: [rca_case_id], references: [id], onDelete: Cascade)

  @@index([rca_case_id], map: "idx_cmp_rca_case_id")
}

model rca_reviewer {
  id          Int     @id @default(autoincrement())
  rca_case_id String  @db.VarChar(50)
  name        String  @db.VarChar(255)
  position    String? @db.VarChar(100)
  department  String? @db.VarChar(100)
  sort_order  Int?    @default(0)
  rca_case    rca_case @relation(fields: [rca_case_id], references: [id], onDelete: Cascade)

  @@index([rca_case_id], map: "idx_rev_rca_case_id")
}

model standard_rca_case {
  id                       String    @id @db.VarChar(50)
  rm_no                    String?   @db.VarChar(50)
  rca_type                 String?   @default("full") @db.VarChar(20)
  incident_id              Int?
  incident_id_risk         Int?
  source_trigger_review_id Int?
  topic                    String    @db.VarChar(255)
  incident_date            DateTime? @db.DateTime(0)
  rca_team                 String?   @db.VarChar(255)
  severity                 String?   @db.VarChar(10)
  is_not_risk              Boolean?  @default(false)
  what_happened            String?   @db.Text
  actual_impact            String?   @db.Text
  potential_impact         String?   @db.Text
  info_interview           Boolean?  @default(false)
  info_cctv                Boolean?  @default(false)
  info_document            Boolean?  @default(false)
  info_inspection          Boolean?  @default(false)
  status                   String?   @default("pending") @db.VarChar(50)
  created_by               Int?
  created_at               DateTime  @default(now()) @db.Timestamp(0)
  updated_at               DateTime  @default(now()) @db.Timestamp(0)
  timelines                standard_rca_timeline[]
  whys                     standard_rca_why[]
  fishbones                standard_rca_fishbone[]
  process_analyses         standard_rca_process_analysis[]
  capas                    standard_rca_capa[]
  review_sessions          standard_rca_review_session[]
}

model standard_rca_timeline {
  id                   Int       @id @default(autoincrement())
  standard_rca_case_id String    @db.VarChar(50)
  event_time           String    @db.VarChar(100)
  event_date           DateTime? @db.Date
  event_description    String    @db.Text
  is_critical_point    Boolean?  @default(false)
  tag                  String?   @db.VarChar(50)
  sort_order           Int?      @default(0)
  created_at           DateTime  @default(now()) @db.Timestamp(0)
  standard_rca_case    standard_rca_case @relation(fields: [standard_rca_case_id], references: [id], onDelete: Cascade)

  @@index([standard_rca_case_id], map: "idx_std_timeline_case_id")
}

model standard_rca_why {
  id                   Int      @id @default(autoincrement())
  standard_rca_case_id String   @db.VarChar(50)
  level                Int
  question             String?  @db.Text
  answer               String   @db.Text
  sort_order           Int?     @default(0)
  created_at           DateTime @default(now()) @db.Timestamp(0)
  standard_rca_case    standard_rca_case @relation(fields: [standard_rca_case_id], references: [id], onDelete: Cascade)

  @@index([standard_rca_case_id], map: "idx_std_why_case_id")
}

model standard_rca_fishbone {
  id                   Int      @id @default(autoincrement())
  standard_rca_case_id String   @db.VarChar(50)
  category             String   @db.VarChar(50)
  factor               String   @db.Text
  sub_factor           String?  @db.Text
  sort_order           Int?     @default(0)
  created_at           DateTime @default(now()) @db.Timestamp(0)
  standard_rca_case    standard_rca_case @relation(fields: [standard_rca_case_id], references: [id], onDelete: Cascade)

  @@index([standard_rca_case_id], map: "idx_std_fish_case_id")
}

model standard_rca_process_analysis {
  id                   Int      @id @default(autoincrement())
  standard_rca_case_id String   @db.VarChar(50)
  process_key          String   @db.VarChar(100)
  problem              String?  @db.Text
  tier1_personnel      String?  @db.Text
  tier2_teamwork       String?  @db.Text
  tier3_environment    String?  @db.Text
  tier4_policy         String?  @db.Text
  tier5_external       String?  @db.Text
  corrective_action    String?  @db.Text
  sort_order           Int?     @default(0)
  created_at           DateTime @default(now()) @db.Timestamp(0)
  standard_rca_case    standard_rca_case @relation(fields: [standard_rca_case_id], references: [id], onDelete: Cascade)

  @@index([standard_rca_case_id], map: "idx_std_process_case_id")
}

model standard_rca_capa {
  id                   Int       @id @default(autoincrement())
  standard_rca_case_id String    @db.VarChar(50)
  action               String    @db.Text
  type                 String    @db.VarChar(50)
  responsible          String    @db.VarChar(255)
  due_date             DateTime? @db.Date
  status               String?   @default("pending") @db.VarChar(50)
  evidence             String?   @db.Text
  sort_order           Int?      @default(0)
  created_at           DateTime  @default(now()) @db.Timestamp(0)
  standard_rca_case    standard_rca_case @relation(fields: [standard_rca_case_id], references: [id], onDelete: Cascade)

  @@index([standard_rca_case_id], map: "idx_std_capa_case_id")
}

model standard_rca_review_session {
  id                   Int       @id @default(autoincrement())
  standard_rca_case_id String    @db.VarChar(50)
  reviewers            String?   @db.Text
  review_date_time     DateTime? @db.DateTime(0)
  notes                String?   @db.Text
  sort_order           Int?      @default(0)
  created_at           DateTime  @default(now()) @db.Timestamp(0)
  standard_rca_case    standard_rca_case @relation(fields: [standard_rca_case_id], references: [id], onDelete: Cascade)

  @@index([standard_rca_case_id], map: "idx_std_session_case_id")
}
