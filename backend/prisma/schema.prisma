  source                  String?   @default("มาตรฐานสำคัญ 9 ด้าน") @db.VarChar(100)
  scope_level             String    @default("department") @db.VarChar(20)
  department_id           String    @db.VarChar(10)
  program_id              Int?
  category_name           String?   @db.VarChar(100)
  safety_goal             String?   @db.VarChar(255)
  essential_std           String?   @db.VarChar(255)
  risk_owner_name         String?   @db.VarChar(255)
  is_never_event          Int       @default(0) @db.TinyInt
  initial_likelihood      Int       @default(1) @db.TinyInt
  initial_consequence     Int       @default(1) @db.TinyInt
  initial_risk_score      Int       @default(1)
  initial_risk_level      String    @default("green") @db.VarChar(20)
  risk_prevention         String?   @db.Text
  risk_transfer           String?   @db.Text
  risk_monitor            String?   @db.Text
  risk_mitigation         String?   @db.Text
  qi_plan                 String?   @db.Text
  review_frequency_months Int       @default(3)
  last_reviewed_date      DateTime? @db.Date
  next_review_date        DateTime? @db.Date
  residual_risk_level     String?   @db.VarChar(50)
  status                  String    @default("open") @db.VarChar(20)
  created_at              DateTime? @default(now()) @db.Timestamp(0)
  updated_at              DateTime? @default(now()) @db.Timestamp(0)
  created_by              Int?

  reviews                 riskanalysis_review[]
}

model riskanalysis_review {
  id                       Int          @id @default(autoincrement())
  risk_analysis_id         Int
  review_date              DateTime     @db.Date
  review_cycle_no          Int          @default(1)
  result_of_review         String       @db.Text
  incident_count_in_period Int?         @default(0)
  current_likelihood       Int          @default(1) @db.TinyInt
  current_consequence      Int          @default(1) @db.TinyInt
  current_risk_score       Int          @default(1)
  current_risk_level       String       @default("green") @db.VarChar(20)
  updated_prevention       String?      @db.Text
  is_escalated             Int          @default(0) @db.TinyInt
  escalation_target        String?      @db.VarChar(100)
  reviewed_by              String?      @db.VarChar(255)
  created_at               DateTime?    @default(now()) @db.Timestamp(0)

  risk                     riskanalysis @relation(fields: [risk_analysis_id], references: [id], onDelete: Cascade)

  @@index([risk_analysis_id], map: "idx_risk_analysis_id")
}
