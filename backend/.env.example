# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# DEVELOPMENT DATABASE ONLY. NEVER USE PRODUCTION CREDENTIALS HERE.
DATABASE_URL="mysql://root:password@localhost:3306/riskhospital_dev"

# LINE Messaging API Secrets
LINE_CHANNEL_ACCESS_TOKEN="your_channel_access_token_here"
LINE_CHANNEL_SECRET="your_channel_secret_here"

# Authentication
# Generate a unique 32+ character secret before starting the backend.
JWT_SECRET=""
# Optional directory for the ignored development-only generated secret file.
JWT_DEVELOPMENT_SECRET_FILE=""
PORT=3000
CORS_ORIGINS="http://localhost:5173"
SWAGGER_ENABLED="false"
AI_ASSISTANT_ENABLED="false"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_API_KEY=""
